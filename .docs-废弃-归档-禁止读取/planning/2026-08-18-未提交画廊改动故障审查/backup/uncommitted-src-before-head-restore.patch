+/**
+ * 画廊激活恢复的最小状态机。
+ *
+ * MediaGrid 的真实生命周期会依次调用 `begin`、`advance`、`fail`、`retry` 与
+ * `open`；把这段顺序抽出后，失败恢复和旧激活代次丢弃可以在不挂载 SFC 的
+ * 测试环境中稳定回归。
+ */
+export type GalleryActivationBarrierPhase =
+  | 'idle'
+  | 'hydrating'
+  | 'layout'
+  | 'scroll'
+  | 'paint'
+  | 'open'
+  | 'failed'
+
+const PHASE_ORDER: Record<GalleryActivationBarrierPhase, number> = {
+  idle: 0,
+  hydrating: 1,
+  layout: 2,
+  scroll: 3,
+  paint: 4,
+  open: 5,
+  failed: -1,
+}
+
+export interface GalleryActivationBarrierSnapshot {
+  generation: number
+  phase: GalleryActivationBarrierPhase
+}
+
+export interface GalleryActivationBarrier {
+  begin(generation: number): GalleryActivationBarrierSnapshot
+  advance(generation: number, phase: 'layout' | 'scroll' | 'paint'): boolean
+  fail(generation: number): boolean
+  retry(generation: number): boolean
+  open(generation: number): boolean
+  isOpen(generation: number): boolean
+  snapshot(): GalleryActivationBarrierSnapshot
+}
+
+/** 创建一个只接受当前激活代次的画廊恢复屏障。 */
+export function createGalleryActivationBarrier(): GalleryActivationBarrier {
+  let current: GalleryActivationBarrierSnapshot = { generation: -1, phase: 'idle' }
+
+  function isCurrent(generation: number): boolean {
+    return generation === current.generation
+  }
+
+  function begin(generation: number): GalleryActivationBarrierSnapshot {
+    current = { generation, phase: 'hydrating' }
+    return { ...current }
+  }
+
+  function advance(generation: number, phase: 'layout' | 'scroll' | 'paint'): boolean {
+    if (!isCurrent(generation) || current.phase === 'failed') return false
+    if (PHASE_ORDER[phase] < PHASE_ORDER[current.phase]) return false
+    current = { generation, phase }
+    return true
+  }
+
+  function fail(generation: number): boolean {
+    if (!isCurrent(generation)) return false
+    current = { generation, phase: 'failed' }
+    return true
+  }
+
+  function retry(generation: number): boolean {
+    if (!isCurrent(generation) || current.phase !== 'failed') return false
+    current = { generation, phase: 'hydrating' }
+    return true
+  }
+
+  function open(generation: number): boolean {
+    if (!isCurrent(generation) || current.phase !== 'paint') return false
+    current = { generation, phase: 'open' }
+    return true
+  }
+
+  return {
+    begin,
+    advance,
+    fail,
+    retry,
+    open,
+    isOpen: (generation) => isCurrent(generation) && current.phase === 'open',
+    snapshot: () => ({ ...current }),
+  }
+}

+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { createPinia, setActivePinia } from 'pinia'
+import { buildCommandContext } from './context'
+import { createCommandRegistry } from './registry'
+import type { CommandContext } from './types'
+import { useViewStore } from '../stores/viewStore'
+
+function baseContext(overrides: Partial<CommandContext> = {}): CommandContext {
+  return {
+    view: 'grid',
+    galleryRouteBlocked: false,
+    activeViewer: null,
+    selection: { count: 0, isSingle: false },
+    contextTarget: null,
+    ...overrides,
+  }
+}
+
+describe('galleryRouteBlocked command gate', () => {
+  beforeEach(() => setActivePinia(createPinia()))
+
+  it('blocked hydration never masquerades as grid and retry success restores grid context', () => {
+    const view = useViewStore()
+    const token = view.beginRouteHydration('/collections/7', 'collection:7')
+
+    const blocked = buildCommandContext({ routePath: '/collections/7' })
+    expect(blocked.galleryRouteBlocked).toBe(true)
+    expect(blocked.view).toBe('blocked')
+
+    expect(view.completeRouteHydration('/collections/7', token, 'collection:7')).toBe(true)
+    const ready = buildCommandContext({ routePath: '/collections/7' })
+    expect(ready.galleryRouteBlocked).toBe(false)
+    expect(ready.view).toBe('grid')
+  })
+
+  it('registry query/run 对 blocked context 一律隐藏且不执行本地命令', () => {
+    const registry = createCommandRegistry()
+    const run = vi.fn()
+    registry.register({
+      id: 'grid.testUndo',
+      title: 'undo',
+      group: 'navigation',
+      when: (ctx) => ctx.view === 'grid',
+      run,
+    })
+
+    const blocked = baseContext({ view: 'blocked', galleryRouteBlocked: true })
+    expect(registry.query(blocked)).toEqual([])
+    registry.run('grid.testUndo', blocked)
+    expect(run).not.toHaveBeenCalled()
+
+    registry.run('grid.testUndo', baseContext())
+    expect(run).toHaveBeenCalledOnce()
+  })
+
+  it('fallback shield 通过 galleryInteractionBlocked 复用同一命令门', () => {
+    const blocked = buildCommandContext({ galleryInteractionBlocked: true })
+    expect(blocked.galleryRouteBlocked).toBe(false)
+    expect(blocked.galleryInteractionBlocked).toBe(true)
+    expect(blocked.view).toBe('blocked')
+  })
+})

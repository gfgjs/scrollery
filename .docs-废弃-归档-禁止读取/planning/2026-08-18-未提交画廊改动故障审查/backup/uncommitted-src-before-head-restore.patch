+import { describe, expect, it } from 'vitest'
+import { isEditingRequestCurrent, type EditingRequestIdentity } from './contentViewerEditing.helpers'
+
+function request(overrides: Partial<EditingRequestIdentity> = {}): EditingRequestIdentity {
+  return {
+    itemId: 1,
+    route: '/view/1',
+    viewerGeneration: 1,
+    requestToken: 1,
+    ...overrides,
+  }
+}
+
+describe('ContentViewer 编辑授权回包当前性', () => {
+  it('A await 后已切到 B 时，A 授权回包不能打开 B editor', () => {
+    const a = request()
+    const b = request({ itemId: 2, route: '/view/2', viewerGeneration: 2, requestToken: 2 })
+    expect(isEditingRequestCurrent(a, b)).toBe(false)
+  })
+
+  it('B 新请求在当前条目/路由/代次匹配时可以打开 editor', () => {
+    const b = request({ itemId: 2, route: '/view/2', viewerGeneration: 2, requestToken: 2 })
+    expect(isEditingRequestCurrent(b, b)).toBe(true)
+  })
+
+  it('A→B→A 即使 id/route 回到 A，旧 token 仍不能复活', () => {
+    const oldA = request()
+    const newA = request({ viewerGeneration: 3, requestToken: 3 })
+    expect(isEditingRequestCurrent(oldA, newA)).toBe(false)
+  })
+})

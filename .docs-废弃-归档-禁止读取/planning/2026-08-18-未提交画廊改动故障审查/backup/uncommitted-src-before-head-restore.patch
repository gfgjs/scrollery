--- /dev/null
+++ b/src/stores/viewStore.spec.ts
@@ -0,0 +1,42 @@
+import { describe, expect, it, beforeEach } from 'vitest'
+import { createPinia, setActivePinia } from 'pinia'
+import { useViewStore } from './viewStore'
+import type { Collection } from '../types/media'
+
+describe('viewStore route hydration lifecycle', () => {
+  beforeEach(() => setActivePinia(createPinia()))
+
+  it('旧 collection hydration 被新 person route 替代时，旧完成不能释放新 pending', () => {
+    const store = useViewStore()
+    const oldToken = store.beginRouteHydration('/collections/7')
+    const newToken = store.beginRouteHydration('/persons/3')
+
+    expect(store.isRouteHydrated('/persons/3')).toBe(false)
+    expect(store.completeRouteHydration('/collections/7', oldToken)).toBe(false)
+    expect(store.routeHydrationPending).toBe(true)
+    expect(store.completeRouteHydration('/persons/3', newToken)).toBe(true)
+    expect(store.isRouteHydrated('/persons/3')).toBe(true)
+    expect(store.isRouteHydrated('/collections/7')).toBe(false)
+  })
+
+  it('同一路由仅在 viewStore 写入后才报告已水合', () => {
+    const store = useViewStore()
+    const token = store.beginRouteHydration('/collections/9', 'collection:9')
+    expect(store.isRouteHydrated('/collections/9')).toBe(false)
+    store.setActiveCollection({ id: 9 } as unknown as Collection)
+    expect(store.completeRouteHydration('/collections/9', token, 'collection:9')).toBe(true)
+    expect(store.isRouteHydrated('/collections/9', 'collection:9')).toBe(true)
+  })
+
+  it('失败状态阻断旧身份，重试后必须用同一路由目标重新确认', () => {
+    const store = useViewStore()
+    const token = store.beginRouteHydration('/persons/7', 'person:7')
+    expect(store.failRouteHydration('/persons/7', token, new Error('load'))).toBe(true)
+    expect(store.routeHydrationStatus).toBe('failed')
+    expect(store.isRouteHydrated('/persons/7', 'person:7')).toBe(false)
+    expect(store.retryRouteHydration('/persons/7')).toBe(true)
+    const retryToken = store.beginRouteHydration('/persons/7', 'person:7')
+    expect(store.completeRouteHydration('/persons/7', retryToken, 'person:7')).toBe(true)
+    expect(store.isRouteHydrated('/persons/7', 'person:7')).toBe(true)
+  })
+})

 import type { MediaMeta } from '../../types/layout'
 
+/** 只有已有摘要且当前 compute 已结束，totalRows=0 才是可展示的真实空结果。 */
+export function isGalleryLayoutConfirmed(
+  hasLayout: boolean,
+  isComputing: boolean,
+  status: 'idle' | 'pending' | 'ready' | 'failed' | 'timeout' = 'ready',
+): boolean {
+  return hasLayout && !isComputing && status === 'ready'
+}
+
+/**
+ * 路由返回期间锁住画廊外框的实际主轴宽度。
+ *
+ * 仅写 width 会被父级 flex 的自动收缩覆盖；同时钉住 flex-basis、min/max 才能让
+ * WebView2 的 computed geometry 在侧栏 margin 动画期间保持同一宽度。`undefined`
+ * 代表正常跟随父级布局。
+ */
+export function buildViewportLockStyle(width: number): Record<string, string> | undefined {
+  if (!(width > 0) || !Number.isFinite(width)) return undefined
+  const cssWidth = `${width}px`
+  return {
+    width: cssWidth,
+    minWidth: cssWidth,
+    maxWidth: cssWidth,
+    flex: `0 0 ${cssWidth}`,
+  }
+}
+
+/**
+ * route-return 每一代都从当前 wrapper 取锁点；只有 wrapper 暂时不可读时才退回上一帧稳定宽度。
+ * 这样 manual→route-return 在 transitioning 仍为 true 时也不会漏锁或复用旧代宽度。
+ */
+export function pickRouteReturnViewportLockWidth(
+  currentWrapperWidth: number,
+  stableWidth: number,
+): number | null {
+  if (currentWrapperWidth > 0 && Number.isFinite(currentWrapperWidth)) return currentWrapperWidth
+  if (stableWidth > 0 && Number.isFinite(stableWidth)) return stableWidth
+  return null
+}
+
+/**
+ * 滚动停稳回调提交前的当前性判定。
+ *
+ * 150ms 定时器可能跨过 KeepAlive 同实例的 view/route 换代；回调只能提交它捕获的
+ * identity 对应的位置，不能把旧画廊的停稳状态写进当前画廊。
+ */
+export interface GalleryScrollSettleSnapshot {
+  identity: string
+  viewKey: string
+  scrollPosition: number
+}
+
+export function canCommitGalleryScrollSettle(
+  snapshot: GalleryScrollSettleSnapshot,
+  currentIdentity: string,
+  active: boolean,
+  blocked: boolean,
+): boolean {
+  return active && !blocked && snapshot.identity === currentIdentity
+}

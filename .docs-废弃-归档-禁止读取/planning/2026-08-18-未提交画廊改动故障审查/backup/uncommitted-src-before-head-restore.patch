index 0000000000000000000000000000000000000000..b0128004fd9d637c344e2e08934fdfd2909e4774
--- /dev/null
+++ b/src/utils/viewerCloseTransition.ts
@@ -0,0 +1,85 @@
+import { isGalleryRoute } from './galleryQuery'
+import { isViewerRoute } from './mediaRoute'
+
+/** 关闭大图的淡出时长；进入查看器不消费这组动画。 */
+export const VIEWER_CLOSE_FADE_MS = 160
+/** transitionend 丢失或 WebView 中断过渡时的离场兜底上限。 */
+export const VIEWER_CLOSE_FALLBACK_MS = 300
+/** 画廊 ready 信号异常时的最后释放时间，避免旧层永久拦截输入。 */
+export const VIEWER_CLOSE_READY_TIMEOUT_MS = 600
+
+/** 只把查看器 → 非查看器视为关闭；查看器间 replace（翻页/换类型）不触发淡出。 */
+export function isViewerCloseNavigation(fromPath: string, toPath: string): boolean {
+  return isViewerRoute(fromPath) && !isViewerRoute(toPath)
+}
+
+/** 只有返回真正画廊时才等待四分片 ready；设置/插件等页面立即释放旧查看器。 */
+export function viewerCloseNeedsGalleryReady(toPath: string): boolean {
+  return isGalleryRoute(toPath)
+}
+
+/** 关闭进行中只允许原始目标继续，防止重复 Esc/back/侧栏点击改写离场目标。 */
+export function allowViewerCloseNavigation(
+  closing: boolean,
+  closeTarget: string | null,
+  toFullPath: string,
+): boolean {
+  return !closing || closeTarget === toFullPath
+}
+
+/**
+ * afterEach 只可收尾「原始关闭目标」本身的中止/取消。
+ *
+ * 关闭闸门会主动拒绝后续非原始导航；Vue Router 为这类拒绝返回 aborted(type=4)。
+ * 若只看 failure，会把这次重复点击误当成原始关闭失败，提前释放 closing/焦点屏障。
+ */
+export function isExpectedViewerCloseFailure(
+  closeTarget: string | null,
+  failedTarget: string,
+  failureType: number | undefined,
+): boolean {
+  if (closeTarget === null || closeTarget !== failedTarget) return false
+  // NavigationFailureType.aborted=4, cancelled=8。duplicated=16 不是原始关闭失败，
+  // 不能拿它作为解锁条件；常量直接写数值以保持该纯工具不依赖路由运行时。
+  return failureType === 4 || failureType === 8
+}
+
+/**
+ * 关闭导航尝试的轻量所有权账本。
+ *
+ * Vue Router 在第一个目标仍在等待 guard 时收到第二个同目标 push，会先以
+ * `cancelled`(8) 收尾第一个尝试，再继续第二个尝试。afterEach 没有 attempt id，
+ * 所以 AppShell 只能按同目标 FIFO 账本消费；只要队列里仍有替代尝试，旧失败就
+ * 不能释放当前 generation。
+ */
+export interface ViewerCloseAttempt {
+  target: string
+  generation: number
+}
+
+export interface ViewerCloseAttemptTracker {
+  register(target: string, generation: number): void
+  consume(target: string, generation: number): { attempt: ViewerCloseAttempt; hasReplacement: boolean } | null
+  clear(): void
+}
+
+export function createViewerCloseAttemptTracker(): ViewerCloseAttemptTracker {
+  const attempts: ViewerCloseAttempt[] = []
+
+  return {
+    register(target, generation) {
+      attempts.push({ target, generation })
+    },
+    consume(target, generation) {
+      const index = attempts.findIndex(
+        (attempt) => attempt.target === target && attempt.generation === generation,
+      )
+      if (index < 0) return null
+      const [attempt] = attempts.splice(index, 1)
+      return { attempt, hasReplacement: attempts.some((item) => item.generation === generation) }
+    },
+    clear() {
+      attempts.length = 0
+    },
+  }
+}

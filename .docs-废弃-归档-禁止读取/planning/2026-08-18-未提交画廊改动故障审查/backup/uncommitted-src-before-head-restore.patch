+/**
+ * Canvas 首绘 ready 的语义判定：必须在当前可见区真实遍历到至少一行有 item 的 normal row。
+ * 非零尺寸、空 rows、仅 separator 或上一 view 的行都不能作为当前首绘证据。
+ */
+export function hasDrawableCanvasRows(
+  rows: readonly LayoutRow[],
+  range: VisibleRowRange,
+): boolean {
+  const start = Math.max(0, range.start)
+  const end = Math.min(rows.length, Math.max(start, range.end))
+  for (let i = start; i < end; i++) {
+    const row = rows[i]
+    if (row.rowType === 'normal' && row.items.length > 0) return true
+  }
+  return false
+}

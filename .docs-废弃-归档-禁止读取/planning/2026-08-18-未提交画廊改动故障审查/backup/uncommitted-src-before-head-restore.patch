+import { describe, expect, it } from 'vitest'
+import {
+  VIEWER_CLOSE_FADE_MS,
+  VIEWER_CLOSE_FALLBACK_MS,
+  VIEWER_CLOSE_READY_TIMEOUT_MS,
+  allowViewerCloseNavigation,
+  isViewerCloseNavigation,
+  viewerCloseNeedsGalleryReady,
+  isExpectedViewerCloseFailure,
+} from './viewerCloseTransition'
+
+describe('viewer close transition route contract', () => {
+  it('仅查看器到非查看器是关闭，查看器互换不淡出', () => {
+    expect(isViewerCloseNavigation('/view/1', '/')).toBe(true)
+    expect(isViewerCloseNavigation('/doc/1', '/favorites')).toBe(true)
+    expect(isViewerCloseNavigation('/audio/1', '/settings')).toBe(true)
+    expect(isViewerCloseNavigation('/view/1', '/view/2')).toBe(false)
+    expect(isViewerCloseNavigation('/', '/view/2')).toBe(false)
+  })
+
+  it('只对 MediaGrid 目标等待 gallery-ready', () => {
+    expect(viewerCloseNeedsGalleryReady('/')).toBe(true)
+    expect(viewerCloseNeedsGalleryReady('/collections/3')).toBe(true)
+    expect(viewerCloseNeedsGalleryReady('/settings')).toBe(false)
+    expect(viewerCloseNeedsGalleryReady('/plugins')).toBe(false)
+  })
+
+  it('关闭闸门只放行原始目标', () => {
+    expect(allowViewerCloseNavigation(false, null, '/settings')).toBe(true)
+    expect(allowViewerCloseNavigation(true, '/', '/')).toBe(true)
+    expect(allowViewerCloseNavigation(true, '/', '/favorites')).toBe(false)
+  })
+
+  it('afterEach 只收尾原始目标的 aborted/cancelled，重复目标与旁路目标不解锁', () => {
+    expect(isExpectedViewerCloseFailure('/', '/', 4)).toBe(true)
+    expect(isExpectedViewerCloseFailure('/', '/', 8)).toBe(true)
+    // closing guard 拒绝 query/侧栏等旁路导航时，failure 也是 aborted(type=4)，但目标不同。
+    expect(isExpectedViewerCloseFailure('/', '/?favorite=1', 4)).toBe(false)
+    expect(isExpectedViewerCloseFailure('/', '/settings', 4)).toBe(false)
+    // 重复原始目标是 duplicated(type=16)，不是原始关闭失败。
+    expect(isExpectedViewerCloseFailure('/', '/', 16)).toBe(false)
+    expect(isExpectedViewerCloseFailure(null, '/', 4)).toBe(false)
+  })
+
+  it('淡出与兜底时间符合交接契约，reduced-motion 由调用方选择 0ms', () => {
+    expect(VIEWER_CLOSE_FADE_MS).toBeGreaterThanOrEqual(140)
+    expect(VIEWER_CLOSE_FADE_MS).toBeLessThanOrEqual(180)
+    expect(VIEWER_CLOSE_FALLBACK_MS).toBeGreaterThan(VIEWER_CLOSE_FADE_MS)
+    expect(VIEWER_CLOSE_READY_TIMEOUT_MS).toBeGreaterThan(VIEWER_CLOSE_FALLBACK_MS)
+  })
+})

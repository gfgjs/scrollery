+      schedulingAllowed: () => allowed.value,
+    })
+
+    visibleRows.value = [row(1)]
+    await nextTick()
+    allowed.value = false
+    await nextTick()
+    await vi.advanceTimersByTimeAsync(200)
+    expect(invokeIpc).not.toHaveBeenCalled()
+
+    allowed.value = true
+    await nextTick()
+    await vi.advanceTimersByTimeAsync(200)
+    expect(invokeIpc).toHaveBeenCalledTimes(1)
+  })
+
+  it('view/activation 换代后迟到回包不重算，current response 才刷新', async () => {
+    const visibleRows = ref<LayoutRow[]>([])
+    const isScrolling = ref(false)
+    const allowed = ref(true)
+    const identity = ref('view-old')
+    const recompute = vi.fn(() => Promise.resolve())
+    const refresh = vi.fn()
+    const first = deferred<number>()
+    invokeIpc.mockReturnValueOnce(first.promise).mockResolvedValue(1)
+    useViewportDimPriority({
+      visibleRows,
+      isScrolling,
+      recompute,
+      refresh,
+      resetKey: () => identity.value,
+      schedulingAllowed: () => allowed.value,
+    })
+
+    visibleRows.value = [row(2)]
+    await nextTick()
+    await vi.advanceTimersByTimeAsync(200)
+    expect(invokeIpc).toHaveBeenCalledTimes(1)
+
+    identity.value = 'view-new'
+    await nextTick()
+    first.resolve(1)
+    await Promise.resolve()
+    await Promise.resolve()
+    expect(recompute).not.toHaveBeenCalled()
+    expect(refresh).not.toHaveBeenCalled()
+
+    visibleRows.value = [row(3)]
+    await nextTick()
+    await vi.advanceTimersByTimeAsync(200)
+    await Promise.resolve()
+    await Promise.resolve()
+    expect(recompute).toHaveBeenCalledTimes(1)
+    expect(refresh).toHaveBeenCalledTimes(1)
+  })
+
+  it('A 在途期间 B timer 不丢，A resolve 后重新发起 B priority', async () => {
+    const visibleRows = ref<LayoutRow[]>([])
+    const isScrolling = ref(false)
+    const allowed = ref(true)
+    const identity = ref('view-a')
+    const recompute = vi.fn(() => Promise.resolve())
+    const refresh = vi.fn()
+    const first = deferred<number>()
+    invokeIpc.mockReturnValueOnce(first.promise).mockResolvedValue(1)
+    useViewportDimPriority({

+import { describe, expect, it } from 'vitest'
+import {
+  isGalleryRouteBlocked,
+  resolveRouteEntity,
+  routeHydrationTarget,
+} from './routeHydration'
+
+describe('route hydration entity resolution', () => {
+  it('未知 collection/person 不会以 null 实体成功', async () => {
+    await expect(
+      resolveRouteEntity({ current: undefined, load: async () => true, find: () => undefined }),
+    ).resolves.toEqual({ ok: false, reason: 'not-found' })
+  })
+
+  it('IPC reject 进入可恢复的 load-failed，而不是伪造 ready', async () => {
+    await expect(
+      resolveRouteEntity({ current: undefined, load: async () => false, find: () => undefined }),
+    ).resolves.toEqual({ ok: false, reason: 'load-failed' })
+  })
+
+  it('重试后实体成功解析才放行', async () => {
+    let loaded = false
+    const load = async () => {
+      loaded = true
+      return true
+    }
+    const result = await resolveRouteEntity({
+      current: undefined,
+      load,
+      find: () => (loaded ? { id: 7 } : undefined),
+    })
+    expect(result).toEqual({ ok: true, entity: { id: 7 } })
+  })
+})
+
+describe('galleryRouteBlocked 命令门', () => {
+  it('只阻断当前 collection/person 详情的 pending/failed，ready 后恢复', () => {
+    const pending = {
+      path: '/collections/7',
+      target: 'collection:7',
+      status: 'pending' as const,
+    }
+    expect(routeHydrationTarget('/collections/7')).toBe('collection:7')
+    expect(isGalleryRouteBlocked('/collections/7', pending)).toBe(true)
+    expect(isGalleryRouteBlocked('/collections/7', { ...pending, status: 'failed' })).toBe(true)
+    expect(isGalleryRouteBlocked('/collections/7', { ...pending, status: 'ready' })).toBe(false)
+    expect(isGalleryRouteBlocked('/', pending)).toBe(false)
+  })
+})
diff --git a/src/utils/routeHydration.ts b/src/utils/routeHydration.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e95c66695f66091d63d668b40b717e5a68d2449e
--- /dev/null
+++ b/src/utils/routeHydration.ts
@@ -0,0 +1,49 @@
+/** 路由参数实体的最小解析器；App.vue 用它把「加载失败」与「目标不存在」分开。 */
+export type RouteEntityResolution<T> =
+  | { ok: true; entity: T }
+  | { ok: false; reason: 'load-failed' | 'not-found' }
+
+export type RouteHydrationStatus = 'pending' | 'ready' | 'failed'
+
+/** collection/person 详情路由对应的水合目标；其它路由没有异步实体门。 */
+export function routeHydrationTarget(path: string): string | null {
+  const collectionMatch = path.match(/^\/collections\/(\d+)$/)
+  if (collectionMatch) return `collection:${collectionMatch[1]}`
+  const personMatch = path.match(/^\/persons\/(\d+)$/)
+  if (personMatch) return `person:${personMatch[1]}`
+  return null
+}
+
+export interface RouteHydrationSnapshot {
+  path: string | null
+  target: string | null
+  status: RouteHydrationStatus
+}
+
+/**
+ * 路由命令门：详情路由只有在当前 path/target 已 ready 时才可把画廊当成 grid。
+ * path 由调用方提供，避免在命令快照构造期间隐式读取 useRoute() 的时序竞态。
+ */
+export function isGalleryRouteBlocked(
+  path: string,
+  hydration: RouteHydrationSnapshot,
+): boolean {
+  const target = routeHydrationTarget(path)
+  if (target === null) return false
+  return !(
+    hydration.status === 'ready' &&
+    hydration.path === path &&
+    hydration.target === target
+  )
+}
+
+export async function resolveRouteEntity<T>(opts: {
+  current: T | undefined
+  load: () => Promise<boolean>
+  find: () => T | undefined
+}): Promise<RouteEntityResolution<T>> {
+  if (opts.current !== undefined) return { ok: true, entity: opts.current }
+  if (!(await opts.load())) return { ok: false, reason: 'load-failed' }
+  const entity = opts.find()
+  return entity === undefined ? { ok: false, reason: 'not-found' } : { ok: true, entity }
+}
diff --git a/src/utils/viewerCloseTransition.router.spec.ts b/src/utils/viewerCloseTransition.router.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6473161fffaa75c4bfb60006d98ba0138b472a05
--- /dev/null
+++ b/src/utils/viewerCloseTransition.router.spec.ts
@@ -0,0 +1,255 @@
+import { describe, expect, it } from 'vitest'
+import {
+  createRouter,
+  createMemoryHistory,
+  isNavigationFailure,
+  NavigationFailureType,
+} from 'vue-router'
+import {
+  allowViewerCloseNavigation,
+  createViewerCloseAttemptTracker,
+  isExpectedViewerCloseFailure,
+  isViewerCloseNavigation,
+} from './viewerCloseTransition'
+
+type CloseHarness = {
+  router: ReturnType<typeof createRouter>
+  state: {
+    closing: boolean
+    target: string | null
+    generation: number
+    fallback: boolean
+    shield: boolean
+    cancelFallbackNavigation: boolean
+    abortOriginalNavigation: boolean
+  }
+  releaseFirst: () => void
+}
+
+function createHarness(): CloseHarness {
+  const router = createRouter({
+    history: createMemoryHistory(),
+    routes: [
+      { path: '/view/:id', component: { template: '<div />' } },
+      { path: '/', component: { template: '<div />' } },
+      { path: '/settings', component: { template: '<div />' } },
+      { path: '/collections/:id', component: { template: '<div />' } },
+    ],
+  })
+  const state = {
+    closing: false,
+    target: null as string | null,
+    generation: 0,
+    fallback: false,
+    shield: false,
+    cancelFallbackNavigation: false,
+    abortOriginalNavigation: false,
+  }
+  const attempts = createViewerCloseAttemptTracker()
+  let firstPending = true
+  let releaseFirst = () => {}
+
+  router.beforeEach((to, from) => {
+    if (
+      state.fallback &&
+      state.cancelFallbackNavigation &&
+      (to.fullPath === '/settings' || to.fullPath === '/')
+    ) {
+      return false
+    }
+    if (state.closing) {
+      const allowed = allowViewerCloseNavigation(true, state.target, to.fullPath)
+      if (allowed && state.target === to.fullPath) attempts.register(to.fullPath, state.generation)
+      return allowed
+    }
+    if (!isViewerCloseNavigation(from.path, to.path)) return true
+    state.closing = true
+    state.target = to.fullPath
+    state.generation += 1
+    attempts.clear()
+    attempts.register(to.fullPath, state.generation)
+    if (firstPending) {
+      firstPending = false
+      if (state.abortOriginalNavigation) return false
+      return new Promise<boolean>((resolve) => {
+        releaseFirst = () => {
+          resolve(true)
+        }
+      })
+    }
+    if (state.abortOriginalNavigation) return false
+    return true
+  })
+
+  router.afterEach((to, _from, failure) => {
+    const attempt = state.closing ? attempts.consume(to.fullPath, state.generation) : null
+    if (
+      failure !== undefined &&
+      attempt !== null &&
+      !attempt.hasReplacement &&
+      isExpectedViewerCloseFailure(state.target, to.fullPath, failure.type)
+    ) {
+      // 与 AppShell 同一 ownership contract：原始目标失败且无替代时恢复关闭入口。
+      state.closing = false
+      if (!state.fallback) {
+        state.target = null
+        state.shield = false
+      }
+    }
+    if (
+      failure === undefined &&
+      state.fallback &&
+      state.target !== null &&
+      router.currentRoute.value.fullPath === to.fullPath
+    ) {
+      if (state.target !== to.fullPath && to.path.startsWith('/collections/')) {
+        // 与 AppShell 同一契约：fallback Back 成功落到另一画廊时重新绑定目标代次，
+        // 真实 ready 之前保持 shield；这里只模拟 token/barrier 尚未完成。
+        state.target = to.fullPath
+        state.generation += 1
+        state.fallback = true
+        state.shield = true
+      } else {
+        state.fallback = false
+        state.shield = false
+        state.target = null
+      }
+    }
+  })
+
+  return {
+    router,
+    state,
+    releaseFirst: () => releaseFirst(),
+  }
+}
+
+describe('viewer close navigation ownership', () => {
+  it('first pending → second same target cancels first without releasing closing', async () => {
+    const h = createHarness()
+    await h.router.push('/view/1')
+    const first = h.router.push('/')
+    await new Promise<void>((resolve) => setTimeout(resolve, 0))
+    const second = h.router.push('/')
+    // Router 会在 guard 结束后的 cancellation check 生成 type=8；第二次同目标
+    // 已经改写 pendingLocation，但仍沿用同一 close generation。
+    h.releaseFirst()
+
+    const firstFailure = await first
+    expect(isNavigationFailure(firstFailure, NavigationFailureType.cancelled)).toBe(true)
+    expect(h.state.closing).toBe(true)
+
+    const secondResult = await second
+    expect(secondResult).toBeUndefined()
+    expect(h.router.currentRoute.value.fullPath).toBe('/')
+    expect(h.state.closing).toBe(true)
+  })
+
+  it('旁路导航被 closing guard 拒绝时，不消费原始关闭 attempt', async () => {
+    const h = createHarness()
+    await h.router.push('/view/1')
+    // 先让原始目标提交；leave 交接尚未完成时 closing 仍由 AppShell 持有。
+    const original = h.router.push('/')
+    await new Promise<void>((resolve) => setTimeout(resolve, 0))
+    h.releaseFirst()
+    await original
+    await h.router.push('/view/1')
+    expect(h.state.closing).toBe(true)
+
+    const sideFailure = await h.router.push('/settings')
+    expect(isNavigationFailure(sideFailure, NavigationFailureType.aborted)).toBe(true)
+    expect(h.state.closing).toBe(true)
+  })
+
+  it('原始 viewer→gallery 被 guard 拒绝后可再次发起关闭', async () => {
+    const h = createHarness()
+    await h.router.push('/view/1')
+    h.state.abortOriginalNavigation = true
+
+    const failed = await h.router.push('/')
+    expect(isNavigationFailure(failed, NavigationFailureType.aborted)).toBe(true)
+    expect(h.router.currentRoute.value.fullPath).toBe('/view/1')
+    expect(h.state.closing).toBe(false)
+    expect(h.state.target).toBeNull()
+
+    h.state.abortOriginalNavigation = false
+    const retry = await h.router.push('/')
+    expect(retry).toBeUndefined()
+    expect(h.router.currentRoute.value.fullPath).toBe('/')
+  })
+
+  it('fallback 期间 aborted 不清 shield，只有成功换目标才清理', async () => {
+    const h = createHarness()
+    await h.router.push('/view/1')
+    const original = h.router.push('/')
+    await new Promise<void>((resolve) => setTimeout(resolve, 0))
+    h.releaseFirst()
+    await original
+    h.state.closing = false
+    h.state.fallback = true
+    h.state.shield = true
+    h.state.cancelFallbackNavigation = true
+
+    const aborted = await h.router.push('/settings')
+    expect(isNavigationFailure(aborted, NavigationFailureType.aborted)).toBe(true)
+    expect(h.state.fallback).toBe(true)
+    expect(h.state.shield).toBe(true)
+
+    h.state.cancelFallbackNavigation = false
+    const result = await h.router.push('/settings')
+    expect(result).toBeUndefined()
+    expect(h.state.fallback).toBe(false)
+    expect(h.state.shield).toBe(false)
+  })
+
+  it('fallback Back 失败后保留 dialog，再次成功才清理 shield', async () => {
+    const h = createHarness()
+    await h.router.push('/view/1')
+    const original = h.router.push('/')
+    await new Promise<void>((resolve) => setTimeout(resolve, 0))
+    h.releaseFirst()
+    await original
+    // 模拟 ready timeout 后旧 viewer 已释放、fallback dialog 接管焦点。
+    h.state.closing = false
+    await h.router.push('/view/1')
+    h.state.fallback = true
+    h.state.shield = true
+    h.state.cancelFallbackNavigation = true
+
+    const failed = await h.router.push('/')
+    expect(isNavigationFailure(failed, NavigationFailureType.aborted)).toBe(true)
+    expect(h.state.fallback).toBe(true)
+    expect(h.state.shield).toBe(true)
+
+    h.state.cancelFallbackNavigation = false
+    const success = await h.router.push('/')
+    expect(success).toBeUndefined()
+    expect(h.state.fallback).toBe(false)
+    expect(h.state.shield).toBe(false)
+  })
+
+  it('fallback Back 成功落到另一 gallery 时重新绑定 barrier，ready 后才清 shield', async () => {
+    const h = createHarness()
+    await h.router.push('/view/1')
+    const original = h.router.push('/')
+    await new Promise<void>((resolve) => setTimeout(resolve, 0))
+    h.releaseFirst()
+    await original
+    h.state.closing = false
+    h.state.fallback = true
+    h.state.shield = true
+    h.state.target = '/'
+
+    const success = await h.router.push('/collections/7')
+    expect(success).toBeUndefined()
+    expect(h.state.fallback).toBe(true)
+    expect(h.state.shield).toBe(true)
+    expect(h.state.target).toBe('/collections/7')
+
+    // 模拟新目标四片 ready 后才允许释放 fallback。
+    h.state.fallback = false
+    h.state.shield = false
+    h.state.target = null
+    expect(h.router.currentRoute.value.fullPath).toBe('/collections/7')
+  })
+})

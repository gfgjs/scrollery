+  seamlessGroups: false,
+  resizeDebounceMs: 10,
+  searchQuery: '',
+  searchScope: 'filename',
+})
+const filterState = {
+  apiFilterKey: 'none',
+  toApiFilter: () => ({}),
+}
+const viewState = reactive({
+  activeDirectoryId: null as number | null,
+  activeSmartAlbum: 'all',
+  activeCollection: null as { id: number } | null,
+  activePersonId: null as number | null,
+})
+const aiState = reactive({ isSemanticMode: false, similarityThreshold: 0.5 })
+const scanState = reactive({ isAnyScanRunning: false })
+
+vi.mock('../stores/mediaStore', () => ({ useMediaStore: () => mediaState }))
+vi.mock('../stores/uiStore', () => ({ useUiStore: () => uiState }))
+vi.mock('../stores/filterStore', () => ({ useFilterStore: () => filterState }))
+vi.mock('../stores/viewStore', () => ({ useViewStore: () => viewState }))
+vi.mock('../stores/aiStore', () => ({ useAiStore: () => aiState }))
+vi.mock('../stores/scanStore', () => ({ useScanStore: () => scanState }))
+
+import { useJustifiedLayout } from './useJustifiedLayout'
+
+describe('useJustifiedLayout identity guard', () => {
+  it('同 scheduling generation 内 A→B 切换时，旧 compute guard 立即失效', async () => {
+    mediaState.computeLayout.mockReset().mockResolvedValue(undefined)
+    const identity = ref('view-a')
+    const scope = effectScope()
+    let layout!: ReturnType<typeof useJustifiedLayout>
+    scope.run(() => {
+      layout = useJustifiedLayout(() => 800, {
+        enabled: () => true,
+        getIdentity: () => identity.value,
+      })
+    })
+
+    const oldRun = layout.compute(800)
+    await Promise.resolve()
+    const calls = mediaState.computeLayout.mock.calls as unknown as Array<
+      [unknown, { isCurrent: () => boolean }]
+    >
+    const oldGuard = calls[0]?.[1]
+    expect(oldGuard.isCurrent()).toBe(true)
+    identity.value = 'view-b'
+    expect(oldGuard.isCurrent()).toBe(false)
+
+    const newRun = layout.compute(800)
+    await Promise.all([oldRun, newRun])
+    const newGuard = (mediaState.computeLayout.mock.calls as unknown as Array<
+      [unknown, { isCurrent: () => boolean }]
+    >)[1]?.[1]
+    expect(newGuard.isCurrent()).toBe(true)
+    scope.stop()
+  })
+})

+const { invokeIpc } = vi.hoisted(() => ({ invokeIpc: vi.fn() }))
+const uiState = reactive({
+  gridRowHeight: 100,
+  groupBy: 'none',
+  sortWithinGroup: 'name',
+  sortOrder: 'asc',
+  seamlessGroups: false,
+  layoutMode: 'justified',
+})
+const viewState = reactive({
+  activeDirectoryId: null as number | null,
+  activeSmartAlbum: 'all',
+  activeCollection: null as { id: number } | null,
+  activePersonId: null as number | null,
+})
+const mediaState = reactive({ isComputingLayout: false })
+
+vi.mock('../utils/ipc', () => ({ invokeIpc }))
+vi.mock('../stores/uiStore', () => ({ useUiStore: () => uiState }))
+vi.mock('../stores/viewStore', () => ({ useViewStore: () => viewState }))
+vi.mock('../stores/mediaStore', () => ({ useMediaStore: () => mediaState }))
+
+import { useReflowAnchor } from './useReflowAnchor'
+import { scrollCache } from '../utils/scrollCache'
+
+function deferred<T>() {
+  let resolve!: (value: T) => void
+  const promise = new Promise<T>((done) => {
+    resolve = done
+  })
+  return { promise, resolve }
+}
+
+function row(id: number): LayoutRow {
+  return {
+    rowType: 'normal',
+    y: 100,
+    height: 100,
+    items: [{ id }],
+  } as unknown as LayoutRow
+}
+
+describe('useReflowAnchor identity guard', () => {
+  beforeEach(() => {
+    invokeIpc.mockReset()
+    scrollCache.clear()
+    viewState.activeDirectoryId = null
+    viewState.activeSmartAlbum = 'all'
+    viewState.activeCollection = null
+    viewState.activePersonId = null
+    mediaState.isComputingLayout = false
+  })
+
+  it('collection A anchor 切到 B 后旧 GET_ITEM_Y_BY_ID 不得滚动/写缓存，B 正常成功', async () => {
+    const oldY = deferred<number | null>()
+    const newY = deferred<number | null>()
+    invokeIpc.mockReturnValueOnce(oldY.promise).mockReturnValueOnce(newY.promise)
+    const identity = ref('collection:1')
+    const viewKey = ref('album-all|collection:1|person:none|filter:none')
+    const rows = ref<LayoutRow[]>([row(11)])
+    const el = { scrollTop: 0 } as unknown as HTMLElement
+    const scrollToLogicalY = vi.fn(async () => undefined)
+    const scope = effectScope()
+    let api!: ReturnType<typeof useReflowAnchor>
+    scope.run(() => {
+      api = useReflowAnchor({
+        gridRef: () => el,
+        activeRows: () => rows.value,
+        currentLogicalY: () => 140,
+        getViewKey: () => viewKey.value,
+        bucketActive: () => false,
+        scrollToLogicalY,
+        logicalToPhysical: (y) => y,
+        getIdentity: () => identity.value,
+        isCurrent: () => true,
+      })
+    })
+
+    api.captureReflowAnchor()
+    const oldRestore = api.restoreReflowAnchor()
+    await Promise.resolve()
+    identity.value = 'collection:2'
+    viewKey.value = 'album-all|collection:2|person:none|filter:none'
+    oldY.resolve(360)
+    expect(await oldRestore).toBe(false)
+    expect(el.scrollTop).toBe(0)
+    expect(scrollCache.has(viewKey.value)).toBe(false)
+
+    rows.value = [row(22)]
+    api.captureReflowAnchor()
+    const newRestore = api.restoreReflowAnchor()
+    newY.resolve(480)
+    expect(await newRestore).toBe(true)
+    expect(el.scrollTop).toBe(520)
+    expect(scrollCache.get(viewKey.value)).toBe(520)
+    expect(scrollToLogicalY).not.toHaveBeenCalled()
+    scope.stop()
+  })
+})

@@ -0,0 +1,24 @@
+/** 编辑授权请求捕获的查看器身份。 */
+export interface EditingRequestIdentity {
+  itemId: number
+  route: string
+  viewerGeneration: number
+  requestToken: number
+}
+
+/**
+ * entitlement await 返回后只允许当前条目的请求继续打开编辑器。
+ *
+ * route/id 相同也不能跳过代次与 token：A→B→A 的迟到回包仍属于旧请求。
+ */
+export function isEditingRequestCurrent(
+  request: EditingRequestIdentity,
+  current: EditingRequestIdentity,
+): boolean {
+  return (
+    request.itemId === current.itemId &&
+    request.route === current.route &&
+    request.viewerGeneration === current.viewerGeneration &&
+    request.requestToken === current.requestToken
+  )
+}

+++ b/src/components/media/mediaGridCanvasReady.ts
@@ -0,0 +1,114 @@
+/**
+ * Canvas 画廊就绪确认的生命周期状态机。
+ *
+ * 确认身份由关闭令牌、视图、布局、行集合与宿主会话代次组成；因此旧绘制即使在新布局
+ * 提交后才落地，也不会复用上一代确认。会话代次变化还提供了“父层拒绝旧确认后重试当前行”
+ * 的明确触发点。
+ */
+export interface CanvasReadyAckLifecycle {
+  mount(): void
+  activate(): void
+  deactivate(): void
+  dispose(): void
+  shouldEmit(identity: string, hasDrawableRows: boolean): boolean
+}
+
+/**
+ * Canvas 首绘携带的宿主身份；非 bucket 画廊用它证明当前可见行确实完成了绘制。
+ */
+export interface CanvasDrawIdentity {
+  generation: number
+  viewIdentity: string
+  layoutVersion: number
+  successEpoch: number
+  rowsGeneration: number
+  sessionEpoch: number
+}
+
+/**
+ * 仅接受当前会话、当前 rows 代次且高于激活基线的 Canvas 首绘。
+ *
+ * 非 bucket 模式没有 `layerRef` DOM 行，Canvas 实际 draw ack 是唯一真实行证明；
+ * 零行/旧代/重放 draw 都不能打开 gallery-ready。
+ */
+export function isCurrentCanvasDrawProof(
+  draw: CanvasDrawIdentity | null,
+  expected: CanvasDrawIdentity,
+  rowsBaseline: number,
+  totalRows: number,
+): boolean {
+  if (totalRows <= 0 || draw === null || draw.rowsGeneration <= rowsBaseline) return false
+  return (
+    draw.generation === expected.generation &&
+    draw.viewIdentity === expected.viewIdentity &&
+    draw.layoutVersion === expected.layoutVersion &&
+    draw.successEpoch === expected.successEpoch &&
+    draw.rowsGeneration === expected.rowsGeneration &&
+    draw.sessionEpoch === expected.sessionEpoch
+  )
+}
+
+/**
+ * Canvas 尺寸锁的最小状态机。
+ *
+ * 侧栏 route-return 可能在 `resizeLocked=true` 不变时递增代次；因此不能只看布尔值。
+ * 组件用 `update` 驱动断开 ResizeObserver/取消 rAF，用 `canRun` 让迟到回调按代次失效。
+ */
+export interface CanvasResizeLockLifecycle {
+  update(locked: boolean, generation: number): {
+    changed: boolean
+    lockStarted: boolean
+    unlocked: boolean
+  }
+  canRun(locked: boolean, generation: number): boolean
+}
+
+export function createCanvasResizeLockLifecycle(): CanvasResizeLockLifecycle {
+  let locked = false
+  let generation = 0
+
+  return {
+    update(nextLocked, nextGeneration) {
+      const changed = locked !== nextLocked || generation !== nextGeneration
+      const lockStarted = changed && nextLocked
+      const unlocked = changed && !nextLocked && locked
+      locked = nextLocked
+      generation = nextGeneration
+      return { changed, lockStarted, unlocked }
+    },
+    canRun(nextLocked, nextGeneration) {
+      return !nextLocked && nextGeneration === generation
+    },
+  }
+}
+
+export function createCanvasReadyAckLifecycle(): CanvasReadyAckLifecycle {
+  let active = true
+  let disposed = false
+  let lastAckIdentity: string | null = null
+
+  function resetForActivation(): void {
+    lastAckIdentity = null
+    active = true
+    disposed = false
+  }
+
+  return {
+    mount: resetForActivation,
+    activate: resetForActivation,
+    deactivate() {
+      active = false
+      lastAckIdentity = null
+    },
+    dispose() {
+      active = false
+      disposed = true
+      lastAckIdentity = null
+    },
+    shouldEmit(identity, hasDrawableRows) {
+      if (disposed || !active || !hasDrawableRows || identity === lastAckIdentity) return false
+      lastAckIdentity = identity
+      return true
+    },
+  }
+}

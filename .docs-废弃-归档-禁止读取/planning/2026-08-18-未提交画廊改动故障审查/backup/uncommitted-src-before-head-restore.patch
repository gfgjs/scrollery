+    mediaState.totalItems = 0
+    mediaState.layoutDirty = false
+    mediaState.layoutVersion = 0
+    mediaState.consumeLayoutDirty.mockClear()
+  })
+
+  afterEach(() => {
+    vi.useRealTimers()
+    vi.restoreAllMocks()
+  })
+
+  it('blocked MEDIA_ENRICHED ready 后只回放一次当前 identity', async () => {
+    const h = setup()
+    listenHandlers.get(EVENTS.MEDIA_ENRICHED)?.()
+    await vi.advanceTimersByTimeAsync(2000)
+    expect(h.compute).not.toHaveBeenCalled()
+
+    h.allowed.value = true
+    h.interactive.value = true
+    await nextTick()
+    await Promise.resolve()
+    expect(h.compute).toHaveBeenCalledTimes(1)
+    expect(h.updateVisible).toHaveBeenCalledTimes(1)
+    h.scope.stop()
+  })
+
+  it('blocked 期间换 view 时旧事件不泵入新 view', async () => {
+    const h = setup()
+    listenHandlers.get(EVENTS.MEDIA_ENRICHED)?.()
+    await vi.advanceTimersByTimeAsync(2000)
+    h.identity.value = 'view-new'
+    h.allowed.value = true
+    h.interactive.value = true
+    await nextTick()
+    await Promise.resolve()
+    expect(h.compute).not.toHaveBeenCalled()
+    h.scope.stop()
+  })
+
+  it('folder-stats intent blocked 后在 current ready 一次 compute/loadStats', async () => {
+    const h = setup()
+    h.sync.requestRecompute({ loadStats: true, refreshVisible: true })
+    h.allowed.value = true
+    h.interactive.value = true
+    await nextTick()
+    await Promise.resolve()
+    expect(h.compute).toHaveBeenCalledTimes(1)
+    expect(h.loadStats).toHaveBeenCalledTimes(1)
+    expect(h.updateVisible).toHaveBeenCalledTimes(1)
+    h.scope.stop()
+  })
+
+  it('旧 identity 在途回包不得覆盖 blocked 期间已登记的新 identity intent', async () => {
+    const h = setup()
+    const first = deferred<void>()
+    h.allowed.value = true
+    h.interactive.value = true
+    h.compute.mockImplementationOnce(() => first.promise).mockResolvedValue(undefined)
+
+    // A 已经开始重算；随后切到 B 并进入 blocked，B 的统计 intent 必须留下。
+    h.sync.requestRecompute({ identity: 'view-old', refreshVisible: false })
+    await Promise.resolve()
+    expect(h.compute).toHaveBeenCalledTimes(1)
+    h.identity.value = 'view-new'
+    h.allowed.value = false
+    h.interactive.value = false
+    await nextTick()
+    h.sync.requestRecompute({ identity: 'view-new', loadStats: true, refreshVisible: true })
+
+    first.resolve()
+    await Promise.resolve()
+    await Promise.resolve()
+    expect(h.compute).toHaveBeenCalledTimes(1)
+
+    h.allowed.value = true
+    h.interactive.value = true
+    await nextTick()
+    await Promise.resolve()
+    await Promise.resolve()
+    expect(h.compute).toHaveBeenCalledTimes(2)
+    expect(h.loadStats).toHaveBeenCalledTimes(1)
+    expect(h.updateVisible).toHaveBeenCalledTimes(1)
+    h.scope.stop()
+  })
+})

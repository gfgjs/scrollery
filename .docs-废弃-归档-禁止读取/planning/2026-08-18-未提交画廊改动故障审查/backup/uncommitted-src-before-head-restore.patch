+    first.resolve(0)
+    await Promise.resolve()
+    await Promise.resolve()
+    await vi.advanceTimersByTimeAsync(200)
+    expect(invokeIpc).toHaveBeenCalledTimes(2)
+  })
+
+  it('A stale reject 不得删除 B 代同 id 的 requested 标记', async () => {
+    const visibleRows = ref<LayoutRow[]>([])
+    const isScrolling = ref(false)
+    const allowed = ref(true)
+    const identity = ref('view-a')
+    const recompute = vi.fn(() => Promise.resolve())
+    const refresh = vi.fn()
+    const first = deferred<number>()
+    invokeIpc.mockReturnValueOnce(first.promise).mockRejectedValueOnce(new Error('B failed'))
+    useViewportDimPriority({
+      visibleRows,
+      isScrolling,
+      recompute,
+      refresh,
+      resetKey: () => identity.value,
+      schedulingAllowed: () => allowed.value,
+    })
+
+    visibleRows.value = [row(11)]
+    await nextTick()
+    await vi.advanceTimersByTimeAsync(200)
+    identity.value = 'view-b'
+    await nextTick()
+    await vi.advanceTimersByTimeAsync(200)
+    expect(invokeIpc).toHaveBeenCalledTimes(1)
+    first.reject(new Error('A failed'))
+    await Promise.resolve()
+    await Promise.resolve()
+    await vi.advanceTimersByTimeAsync(200)
+    expect(invokeIpc).toHaveBeenCalledTimes(2)
+  })
+})

+        originalWidth: 0,
+        originalHeight: 0,
+        thumbStatus: 0,
+        thumbPath: null,
+        placeholderColor: null,
+        isFavorited: false,
+        rating: 0,
+        colorLabel: 0,
+      },
+    ],
+  } as LayoutRow
+}
+
+function deferred<T>() {
+  let resolve!: (value: T) => void
+  let reject!: (reason?: unknown) => void
+  const promise = new Promise<T>((done, fail) => {
+    resolve = done
+    reject = fail
+  })
+  return { promise, resolve, reject }
+}
+

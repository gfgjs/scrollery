# 全仓默认:文本以 LF 入库/检出,二进制由 auto 探测保持原样。
* text=auto eol=lf

# Windows 批处理保留 CRLF,兼容 cmd.exe。
*.bat text eol=crlf
*.cmd text eol=crlf

# 法律材料和第三方产物按原始字节校验,显式固定 LF。
third-party/licenses/** text eol=lf
public/vditor/dist/js/graphviz/full.render.js text eol=lf
public/vditor/dist/js/graphviz/viz.js text eol=lf
public/vditor/dist/js/lute/lute.min.js text eol=lf
